[package]
title = "Swarmy Factory Twin"
description = "Standalone Kit viewer app for the Swarmy North Georgia Plant OpenUSD digital twin."
version = "1.0.0"
keywords = ["app", "digital twin", "factory", "swarmy"]

[dependencies]
# --- core viewport / rendering app stack ---
"omni.kit.uiapp" = {}
"omni.kit.renderer.core" = {}
"omni.kit.viewport.window" = {}
"omni.kit.viewport.bundle" = {}
"omni.kit.window.viewport" = {}
"omni.kit.window.stage" = {}
"omni.kit.window.property" = {}
"omni.kit.window.content_browser" = {}
"omni.kit.window.console" = {}
"omni.kit.menu.utils" = {}
"omni.kit.menu.file" = {}
"omni.kit.menu.edit" = {}
"omni.kit.menu.create" = {}
"omni.kit.stage_templates" = {}
"omni.hydra.rtx" = {}
"omni.rtx.settings.core" = {}

# --- our twin extension ---
"omni.swarmy.twin" = {}

[settings]
app.name = "Swarmy Factory Twin"
app.window.title = "Swarmy Factory Twin"
app.viewport.defaults.fillViewport = true

# RTX real-time as default renderer; switch to path tracing for beauty shots
renderer.enabled = "rtx"
renderer.active = "rtx"
rtx.rendermode = "rtx"
rtx.directLighting.sampledLighting.enabled = true

# tell our extension where the twin lives (relative to this app file)
exts."omni.swarmy.twin".stage_path = "../usd/DroneFactory.usd"

# register the local extension search path
[settings.exts."omni.kit.registry.nucleus"]
registries = []

[settings.app.exts]
folders = ["../source/extensions"]

[[test]]
args = []
